# Google sign-in: same OAuth client ID the backend uses (GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API base URL. Leave empty locally (calls go to /api through the dev rewrite).
# Production: https://api.3dwebdev.com
NEXT_PUBLIC_API_BASE_URL=

# Local dev only: where the dev rewrite forwards /api/*. Not set in production.
API_PROXY_TARGET=http://localhost:4000

# Shown as the "contact us" mailto link when login is refused
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=
